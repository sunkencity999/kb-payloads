config wifi-device 'radio0'
	option type 'mac80211'
	option channel '11'

config wifi-iface 'wlan0mgmt'
	option device 'radio0'
	option ifname 'wlan0mgmt'
	option mode 'ap'
	option disabled '0'
	option ssid 'HomeNet'
	option hidden '0'
	option encryption 'psk2'
	option key 'OldKey Here'

config wifi-iface 'wlan0open'
	option device 'radio0'
	option ifname 'wlan0open'
	option mode 'ap'
	option ssid 'FreeHotel'
	encryption 'none'
